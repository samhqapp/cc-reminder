{
  "expo": {
    "name": "CC Reminder",
    "owner": "surajmanalcell",
    "slug": "cc-reminder",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ccreminder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdfdfd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.surajmandal.ccreminder"
    },
    "android": {
      "package": "com.surajmandal.ccreminder",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#aae9e7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61fb4a83-cabe-411b-bf7b-4c600400fc80"
      }
    }
  }
}
